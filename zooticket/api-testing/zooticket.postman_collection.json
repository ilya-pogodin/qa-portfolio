						"{{baseUrl}}"
					],
					"path": [
						"payments"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"orderId\": \"refund-empty\",\n  \"amount\": 1500,\n  \"currency\": \"RUB\",\n  \"returnUrl\": \"https://zooticket.ru/success\"\n}"
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Код ответа 201 для подготовки теста возврата', () => pm.response.to.have.status(201));",
							"const b = pm.response.json();",
							"pm.test('Создан отдельный платёж для теста возврата', () => pm.expect(b).to.have.property('id'));",
							"if (b.id) pm.collectionVariables.set('paymentIdRefundEmpty', b.id);"
						]
					}
				}
			]
		},
		{
			"name": "07c. Возврат — пустое тело",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/payments/{{paymentIdRefundEmpty}}/refund",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"payments",
						"{{paymentIdRefundEmpty}}",
						"refund"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{}"
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Код ответа 400', () => pm.response.to.have.status(400));",
							"pm.test('В message указано отсутствие обязательного поля amount', () => {",
							"  const b = pm.response.json();",
							"  pm.expect(b).to.have.property('message');",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "08. Возврат — повторный",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/payments/{{paymentId}}/refund",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"payments",
						"{{paymentId}}",
						"refund"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"amount\": 1500\n}"
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Код ответа 422', () => pm.response.to.have.status(422));",
							"pm.test('Код ошибки refund_not_allowed', () => {",
							"  pm.expect(pm.response.json().code).to.eql('refund_not_allowed');",
							"});"
						]
					}
				}
			]
		}
	]
}
