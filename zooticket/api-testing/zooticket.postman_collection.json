							"console.log('TC-PAY-02 — фактический код ответа:', pm.response.code);",
							"console.log('TC-PAY-02 — фактическое тело ответа:', pm.response.text());",
							"console.log('DEF-001: не проверяем assertion по коду или id, пока аналитик не уточнит ожидаемое поведение идемпотентного запроса.')"
						]
